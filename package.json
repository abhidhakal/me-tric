{
  "name": "metric",
  "productName": "MeTric",
  "description": "Personal productivity and metric tracking desktop application",
  "author": "Abhinav Dhakal",
  "private": true,
  "version": "1.0.1",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "ELECTRON=true vite",
    "build": "tsc -b && vite build",
    "generate:icons": "node scripts/generate-icons.cjs",
    "build:electron": "tsc -b && ELECTRON=true vite build && cp electron/preload.cjs dist-electron/preload.cjs",
    "build:app": "npm run build:electron && electron-builder --mac dir --arm64 && codesign --force --deep --sign - release/mac-arm64/MeTric.app",
    "build:dmg": "node scripts/generate-dmg-background.cjs && npm run build:electron && electron-builder --mac dmg --universal --publish never",
    "build:win": "npm run build:electron && electron-builder --win nsis --x64 --publish never",
    "build:all": "npm run build:dmg && npm run build:win",
    "start": "npx electron dist-electron/main.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.abhinav.metric",
    "productName": "MeTric",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ]
    },
    "dmg": {
      "title": "${productName}",
      "icon": "build/icon.icns",
      "background": "build/background.png",
      "iconSize": 96,
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Windows-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MeTric"
    }
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
